{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "prelaunch",
            "type": "process",
            "command": "bun",
            "args": ["./scripts/js-prelaunch.ts"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "dev-package-index",
            "type": "process",
            "command": "bun",
            "args": ["./scripts/js-upload-dev-index.ts"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "prelaunch",
            "isBackground": true,
            "problemMatcher": [{
                "base": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Index starting$",
                    "endsPattern": "^Index ready$"
                }
            }]
        },
        {
            "label": "dev-apps",
            "type": "process",
            "command": "bun",
            "args": ["./scripts/js-dev.ts", "--apps"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "dev-package-index",
            "isBackground": true,
            "problemMatcher": [{
                "base": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Dev starting$",
                    "endsPattern": "^Dev ready$"
                }
            }]
        },
        {
            "label": "dev-dash",
            "type": "process",
            "command": "bun",
            "args": ["./scripts/js-dev.ts", "--dash"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "dev-apps",
            "isBackground": true,
            "problemMatcher": [{
                "base": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Dev starting$",
                    "endsPattern": "^Dev ready$"
                }
            }]
        },
        {
            "label": "stop-dev",
            "type": "process",
            "command": "bun",
            "args": ["./scripts/js-dev.ts", "--stop"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
