{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dashboard",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "dev-dash",
            "postDebugTask": "stop-dev"
        },
        {
            "name": "Apps",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "dev-apps",
            "postDebugTask": "stop-dev"
        },
        {
            "name": "Server",
            "type": "bun",
            "request": "launch",
            "program": "${workspaceFolder}/packages-js/server/src/main.ts",
            "args": [
                "--debug",
                "--token-file",
                "${workspaceFolder}/appdata/token.txt",
                "--hash",
                "dev",
                "--trusted-host",
                "localhost:5173=omuapps.com"
            ],
            "cwd": "${workspaceFolder}/appdata",
        },
        {
            "name": "Server (stop)",
            "type": "bun",
            "request": "launch",
            "program": "${workspaceFolder}/packages-js/server/src/main.ts",
            "args": [
                "--stop",
            ],
            "cwd": "${workspaceFolder}/appdata",
        },
        {
            "name": "Server (uninstall)",
            "type": "bun",
            "request": "launch",
            "program": "${workspaceFolder}/packages-js/server/src/main.ts",
            "args": [
                "--uninstall",
            ],
            "cwd": "${workspaceFolder}/appdata",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "DashboardDebug",
            "cwd": "${workspaceFolder}/packages-js/dash/src-tauri",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=./packages-js/dash/src-tauri/Cargo.toml",
                    "--no-default-features"
                ]
            },
        },
    ],
    "compounds": [
        {
            "name": "Dashboard Debugging",
            "configurations": [
                "Apps",
                "DashboardDebug",
            ],
            "preLaunchTask": "dev-apps",
            "stopAll": true,
            "presentation": {
                "group": "Main",
                "order": 0,
            },
        },
        {
            "name": "Dashboard and Sever Debugging",
            "configurations": [
                "Server",
                "Apps",
                "DashboardDebug",
            ],
            "preLaunchTask": "dev-apps",
            "stopAll": true,
            "presentation": {
                "group": "Main",
                "order": 1,
            },
        },
        {
            "name": "All",
            "configurations": [
                "Server",
                "Apps",
                "Dashboard",
            ],
            "preLaunchTask": "dev-apps",
            "stopAll": true,
            "presentation": {
                "group": "Main",
                "order": 2,
            },
        },
    ],
}
